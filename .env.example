# Copy to .env (git-ignored) and adjust. Read automatically by docker compose.
DB_USER=odoo
DB_PASSWORD=odoo
ODOO_PORT=8069
ODOO_GEVENT_PORT=8072

# Database prepared automatically on `docker compose up` (leave empty to skip)
ODOO_DB=ecom
# Modules installed in that database if missing (comma separated)
ODOO_INIT_MODULES=website_sale,fathy
# true = load demo data (new database: --with-demo, existing one: module force-demo)
ODOO_WITH_DEMO=true
